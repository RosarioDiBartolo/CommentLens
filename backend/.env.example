# Copy to backend/.env; never commit real credentials.
YOUTUBE_API_KEY=your_youtube_data_api_key_here
DJANGO_SECRET_KEY=replace_with_a_generated_secret_key
# Local development only; set False in deployed environments.
DEBUG=True

# Reuse completed analyses for 24 hours; 0 always refreshes YouTube data.
ANALYSIS_CACHE_TTL_SECONDS=86400
